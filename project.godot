config_version=5

[application]
config/name="Binh Đoàn Tí Hon"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/quit_on_go_back=false
config/icon="res://assets/icon.svg"

[autoload]
GameDB="*res://scripts/game_db.gd"
Profile="*res://scripts/profile.gd"
Audio="*res://scripts/audio.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=480
window/size/window_height_override=854
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
